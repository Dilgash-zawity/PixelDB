{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Core IPC, the native folder picker, signed app updates, restarting after an update, and opening the author's website. Databases remain confined to the selected workspace through validated commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://dilgash.com"
        },
        {
          "url": "https://dilgash.com/*"
        },
        {
          "url": "https://github.com/Dilgash-zawity/PixelDB/releases/latest"
        }
      ]
    }
  ]
}
