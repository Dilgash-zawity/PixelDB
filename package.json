    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/bun": "^1.4.3",
    "bits-ui": "^2.18.0",
    "cn": "^0.3.0",
